# Next.js public env (copy to .env.local)

# FastAPI inside Docker (published to host)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Use fixture JSON until endpoints are ✅ in docs/PROJECT_STATUS.md
NEXT_PUBLIC_USE_MOCKS=true

# Path to orchestrator_config on host (for container manager)
ORCHESTRATOR_CONFIG_PATH=../../docker/orchestrator_config.yaml
