# Next.js public env (copy to .env.local)

# FastAPI inside Docker (published to host). Browser REST uses /api/orchestrator proxy;
# set this for Next.js server-side proxy + video/asset routes (default localhost:8000).
ORCHESTRATOR_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 6 endpoints are ✅. Use false for E2E against :8000; true for fixture-only UI work.
NEXT_PUBLIC_USE_MOCKS=false

# Path to orchestrator_config on host (for container manager)
ORCHESTRATOR_CONFIG_PATH=../../docker/orchestrator_config.yaml

# Optional: override host data root for path translation (default: repo ./data)
# VIANA_DATA_ROOT=/home/you/Work/ViAna/data
