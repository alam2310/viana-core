{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/checkpoint.schema.json",
  "title": "Checkpoint",
  "description": "Engine resume state written to {output_dir}/{video_stem}.checkpoint.json",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "source_video_path",
    "video_stem",
    "current_frame",
    "total_frames",
    "saved_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "job_id": { "type": "string" },
    "project_id": { "type": "string" },
    "source_video_path": { "type": "string" },
    "video_stem": { "type": "string" },
    "current_frame": { "type": "integer", "minimum": 0 },
    "total_frames": { "type": "integer", "minimum": 1 },
    "counted_track_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "events_rows_written": { "type": "integer", "minimum": 0 },
    "manifest_path": { "type": "string" },
    "saved_at": { "type": "string", "format": "date-time" }
  }
}
