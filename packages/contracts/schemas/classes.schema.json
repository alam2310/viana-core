{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/classes.schema.json",
  "title": "ClassTaxonomy",
  "description": "YOLO class id → analytics hierarchy (configs/classes.yaml)",
  "type": "object",
  "required": ["classes"],
  "additionalProperties": false,
  "properties": {
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/VehicleClass" }
    }
  },
  "$defs": {
    "VehicleClass": {
      "type": "object",
      "required": ["id", "name", "category", "class_type", "sub_class", "aggregate"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "class_type": { "type": "string", "minLength": 1 },
        "sub_class": { "type": "string", "minLength": 1 },
        "aggregate": {
          "type": "boolean",
          "description": "If true, include class in {stem}_15min.csv reports"
        }
      }
    }
  }
}
