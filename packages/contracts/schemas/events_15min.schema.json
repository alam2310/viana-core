{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/events_15min.schema.json",
  "title": "Aggregate15MinRow",
  "description": "One row in {stem}_15min.csv (vehicles + pedestrians, zero-filled). Human-readable CSV headers; window columns are HH:MM (S15).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date", "window_start", "window_end", "location",
    "class_name", "category", "class_type", "direction", "count"
  ],
  "properties": {
    "date": { "type": "string", "description": "CSV header: Date" },
    "window_start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "description": "CSV header: Window Start" },
    "window_end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "description": "CSV header: Window End" },
    "location": { "type": "string", "description": "CSV header: Location" },
    "class_name": { "type": "string", "description": "CSV header: Class Name" },
    "category": { "type": "string", "description": "CSV header: Category" },
    "class_type": { "type": "string", "description": "CSV header: Class Type" },
    "direction": { "enum": ["in", "out"], "description": "CSV header: Direction" },
    "count": { "type": "integer", "minimum": 0, "description": "CSV header: Count" }
  }
}
