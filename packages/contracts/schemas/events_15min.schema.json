{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/events_15min.schema.json",
  "title": "Aggregate15MinRow",
  "description": "One row in {stem}_15min.csv (vehicle classes + pedestrians, zero-filled grid). window_start/window_end are HH:MM (S15). class_name includes Pedestrian when aggregate:true (S33).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "window_start", "window_end", "date", "class_name", "direction", "count", "partial"
  ],
  "properties": {
    "window_start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "window_end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "date": { "type": "string" },
    "location": { "type": "string" },
    "class_name": { "type": "string" },
    "direction": { "enum": ["in", "out"] },
    "count": { "type": "integer", "minimum": 0 },
    "partial": { "type": "boolean" }
  }
}
