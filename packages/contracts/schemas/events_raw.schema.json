{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/events_raw.schema.json",
  "title": "RawCrossingEventRow",
  "description": "One row in {stem}_events.csv (operator event log; S32). Taxonomy hierarchy and box geometry are not columns — look up class_id in classes.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "job_id", "video_file", "track_id", "frame_index",
    "video_pts_ms", "class_name", "direction", "confidence"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string" },
    "video_file": { "type": "string" },
    "track_id": { "type": "integer" },
    "frame_index": { "type": "integer" },
    "video_pts_ms": { "type": "number" },
    "wall_time": { "type": ["string", "null"] },
    "wall_time_source": {
      "enum": ["ocr_recalibrated", "ocr_anchor", "user_fallback", "unavailable", null]
    },
    "date": { "type": "string" },
    "location": { "type": "string" },
    "class_id": { "type": "integer" },
    "class_name": { "type": "string" },
    "direction": { "enum": ["in", "out"] },
    "confidence": { "type": "number" }
  }
}
