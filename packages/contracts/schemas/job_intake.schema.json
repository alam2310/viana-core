{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/job_intake.schema.json",
  "title": "JobIntakeRequest",
  "type": "object",
  "required": ["project_id", "source_video_paths"],
  "additionalProperties": false,
  "properties": {
    "task_type": { "const": "ViAna_Moving", "default": "ViAna_Moving" },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source_video_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_dir": { "type": "string", "minLength": 1 }
  }
}
