{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/job_intake_response.schema.json",
  "title": "JobIntakeResponse",
  "type": "object",
  "required": ["jobs"],
  "additionalProperties": false,
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/JobIntakeItem" }
    }
  },
  "$defs": {
    "JobIntakeItem": {
      "type": "object",
      "required": ["job_id", "status", "source_video_path", "output_dir", "queue_position"],
      "additionalProperties": false,
      "properties": {
        "job_id": { "type": "string" },
        "status": {
          "enum": ["PRESCAN_PENDING", "CHECKPOINT_EXISTS"]
        },
        "source_video_path": { "type": "string" },
        "output_dir": { "type": "string" },
        "queue_position": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
