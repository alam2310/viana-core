{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/job_prescan_confirm.schema.json",
  "title": "JobPrescanConfirmRequest",
  "type": "object",
  "required": ["metadata", "task_parameters"],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "#/$defs/ConfirmedMetadata" },
    "task_parameters": { "$ref": "#/$defs/ViAnaTaskParameters" },
    "calibration_profile_id": { "type": "string" }
  },
  "$defs": {
    "Point": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "LineSegment": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/Point" },
        "end": { "$ref": "#/$defs/Point" }
      }
    },
    "ConfirmedMetadata": {
      "type": "object",
      "required": ["user_start_time", "user_start_date", "location"],
      "additionalProperties": false,
      "properties": {
        "user_start_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "user_start_date": {
          "type": "string",
          "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{4}$"
        },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "ViAnaTaskParameters": {
      "type": "object",
      "required": ["horizon_line", "counting_line"],
      "additionalProperties": false,
      "properties": {
        "horizon_line": { "$ref": "#/$defs/LineSegment" },
        "counting_line": { "$ref": "#/$defs/LineSegment" },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
        "use_heuristic_truck_split": { "type": "boolean", "default": true },
        "render_video": { "type": "boolean", "default": true },
        "telemetry_detail": { "type": "boolean", "default": false }
      }
    }
  }
}
