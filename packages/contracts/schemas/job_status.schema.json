{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/job_status.schema.json",
  "title": "JobStatus",
  "type": "object",
  "required": [
    "job_id",
    "status",
    "task_type",
    "source_video_path",
    "project_id",
    "output_dir",
    "checkpoint_exists"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "status": {
      "enum": ["PENDING", "PROCESSING", "PAUSED", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "task_type": { "enum": ["ViAna_Moving"] },
    "source_video_path": { "type": "string" },
    "project_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "checkpoint_exists": { "type": "boolean" },
    "gpu_device": { "type": "string", "pattern": "^cuda:[01]$" },
    "queue_position": { "type": "integer", "minimum": 0 },
    "progress": {
      "type": "object",
      "properties": {
        "current_frame": { "type": "integer", "minimum": 0 },
        "total_frames": { "type": "integer", "minimum": 0 },
        "processing_fps": { "type": "number", "minimum": 0 }
      }
    },
    "error_message": { "type": ["string", "null"] }
  }
}
