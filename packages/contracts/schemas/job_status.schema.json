{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/job_status.schema.json",
  "title": "JobStatus",
  "type": "object",
  "required": [
    "job_id",
    "status",
    "task_type",
    "source_video_path",
    "project_id",
    "output_dir",
    "checkpoint_exists",
    "created_at"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "status": {
      "enum": [
        "PRESCAN_PENDING",
        "PRESCAN_RUNNING",
        "PRESCAN_FAILED",
        "CHECKPOINT_EXISTS",
        "AWAITING_REVIEW",
        "READY",
        "PROCESSING",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "task_type": { "enum": ["ViAna_Moving"] },
    "source_video_path": { "type": "string" },
    "project_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "checkpoint_exists": { "type": "boolean" },
    "gpu_device": { "type": "string", "pattern": "^cuda:[01]$" },
    "queue_position": { "type": "integer", "minimum": 0 },
    "progress": {
      "type": "object",
      "properties": {
        "current_frame": { "type": "integer", "minimum": 0 },
        "total_frames": { "type": "integer", "minimum": 0 },
        "processing_fps": { "type": "number", "minimum": 0 },
        "eta_sec": { "type": "number", "minimum": 0 },
        "crossing_count": { "type": "integer", "minimum": 0 }
      }
    },
    "error_message": { "type": ["string", "null"] },
    "proposed_metadata": { "$ref": "#/$defs/JobMetadata" },
    "proposed_lines": { "$ref": "#/$defs/ProposedLines" },
    "proposed_preview_url": { "type": ["string", "null"] },
    "confirmed_metadata": { "$ref": "#/$defs/JobMetadata" },
    "confirmed_task_parameters": { "$ref": "#/$defs/ViAnaTaskParameters" },
    "created_at": { "type": "string", "format": "date-time" },
    "video_duration_sec": { "type": ["number", "null"], "minimum": 0 },
    "processing_duration_sec": { "type": ["number", "null"], "minimum": 0 }
  },
  "$defs": {
    "Point": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "LineSegment": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/Point" },
        "end": { "$ref": "#/$defs/Point" }
      }
    },
    "JobMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_start_time": { "type": "string" },
        "user_start_date": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "ProposedLines": {
      "type": "object",
      "required": ["horizon_line", "counting_line", "confidence"],
      "additionalProperties": false,
      "properties": {
        "horizon_line": { "$ref": "#/$defs/LineSegment" },
        "counting_line": { "$ref": "#/$defs/LineSegment" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ViAnaTaskParameters": {
      "type": "object",
      "required": ["horizon_line", "counting_line"],
      "additionalProperties": false,
      "properties": {
        "horizon_line": { "$ref": "#/$defs/LineSegment" },
        "counting_line": { "$ref": "#/$defs/LineSegment" },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
        "use_heuristic_truck_split": { "type": "boolean", "default": true },
        "render_video": { "type": "boolean", "default": true },
        "telemetry_detail": { "type": "boolean", "default": false }
      }
    }
  }
}
