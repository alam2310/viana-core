{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viana.local/schemas/time_map.schema.json",
  "title": "TimeMap",
  "description": "OCR / user wall-clock anchors for mapping video_pts_ms → wall_time ({stem}.time_map.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "video_stem", "anchors"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "video_stem": { "type": "string", "minLength": 1 },
    "anchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/TimeAnchor" }
    },
    "user_start_date": { "type": ["string", "null"] },
    "user_start_time": { "type": ["string", "null"] }
  },
  "$defs": {
    "TimeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_pts_ms", "wall_time", "source"],
      "properties": {
        "video_pts_ms": { "type": "number" },
        "wall_time": { "type": "string", "format": "date-time" },
        "source": {
          "enum": ["ocr_recalibrated", "ocr_anchor", "user_fallback", "unavailable"]
        },
        "ocr_confidence": { "type": ["number", "null"] },
        "date": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] }
      }
    }
  }
}
